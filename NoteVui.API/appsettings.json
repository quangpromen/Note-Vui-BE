{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=YOUR_SERVER;Database=NoteVuiDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true"
    },
    "JwtSettings": {
        "Key": "YOUR_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARS_LONG",
        "Issuer": "NoteVuiAPI",
        "Audience": "NoteVuiClient",
        "DurationInMinutes": 60
    },
    "AiSettings": {
        "_comment": "DO NOT put your real API key here! Use appsettings.Development.json (gitignored) or User Secrets.",
        "GeminiApiKey": "YOUR_GEMINI_API_KEY",
        "DailyQuotaLimit": 20,
        "GeminiApiUrl": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent"
    }
}